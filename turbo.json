{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "scrape": {
      "cache": false,
      "passThroughEnv": ["SUPABASE_URL", "SUPABASE_SERVICE_ROLE_KEY"]
    }
  }
}
